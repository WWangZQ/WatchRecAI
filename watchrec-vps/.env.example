# Run python3 setup.py to create .env with a random APP_TOKEN.
APP_TOKEN=
# Behind Caddy: 127.0.0.1. For direct IP access: 0.0.0.0.
HOST=127.0.0.1
PORT=8765
TIMEZONE=Asia/Shanghai
# Completed recordings only; 0 disables cleanup. Pending recordings are never auto-deleted.
RETENTION_DAYS=3
LAN_TTL_SECONDS=300
# UPLOAD_DIR=/absolute/path/to/recordings
# Docker only: use 0.0.0.0 for direct IP access; default is loopback for a reverse proxy.
# WATCHREC_BIND=127.0.0.1
# WATCHREC_PORT=8765
